    <Import Project="$(NuGetPackageRoot)cosmos.kernel\3.0.97\build\Cosmos.Kernel.props" Condition="Exists('$(NuGetPackageRoot)cosmos.kernel\3.0.97\build\Cosmos.Kernel.props')" />
